# A further keeper on the pools host, for the deployment that instance %i serves
# (/etc/colosseum/deployment-%i), testnet only. The first deployment's is colosseum-keeper.service;
# this one sends with its own key from keeper-%i.env, so two keepers never share a nonce. Installed
# by ops/host/install.sh; the instances are in docs/HOSTING.md.
[Unit]
Description=colosseum-pools keeper %i (HyperEVM testnet)
After=network-online.target
Wants=network-online.target

[Service]
User=colosseum-keeper
Group=colosseum-keeper
WorkingDirectory=/opt/colosseum-pools/current
EnvironmentFile=/etc/colosseum/deployment-%i.env
EnvironmentFile=/etc/colosseum/keeper-%i.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/colosseum-pools/venv/bin/python -m ops.keeper --deployment ${COLOSSEUM_DEPLOYMENT} \
    --state /var/lib/colosseum-keeper/keeper-${COLOSSEUM_DEPLOYMENT}.json --every 30 --max-windows 5
Restart=always
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/colosseum-keeper
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077
# Not the gateway's, and not the first keeper's key: this instance sends with its own alone.
InaccessiblePaths=/var/lib/colosseum-gw -/var/lib/colosseum-keeper/secrets
# Nor another instance's: all the instances' keepers run as colosseum-keeper, so under instances/
# this one sees an empty, read-only directory with its own directory alone bound back into it. Its
# state stays where it was, /var/lib/colosseum-keeper/keeper-<label>.json.
TemporaryFileSystem=/var/lib/colosseum-keeper/instances:ro
BindReadOnlyPaths=/var/lib/colosseum-keeper/instances/%i

[Install]
WantedBy=multi-user.target
