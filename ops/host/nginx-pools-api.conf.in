# pools-api.usenami.io: Cloudflare -> nginx :443 (Cloudflare Origin CA certificate) -> the
# gateway on 127.0.0.1:8787, plain HTTP. The host's security group lets only Cloudflare reach
# 443. Rendered by ops/host/install.sh, which puts Cloudflare's published ranges in place of
# the first marker below, and only once the certificate is on the host (docs/HOSTING.md).
#
# A further instance (a second deployment beside the first, ops/host_instances.py) is reached at
# /<name>/v1/order, /<name>/v1/health, /<name>/v1/faucet and /<name>/v1/contacts, sent to its own gateway's port
# through an upstream of its own. install.sh puts those upstreams and locations in place of the two INSTANCE markers; with no
# instance, nothing is there.

# Every order costs the gateway six RPC calls. These limits keep that inside the budget of the
# node the GATEWAY reads -- rpc.hyperliquid-testnet.xyz, which we measured at about 100 calls a
# minute (the note in ops/keeper.py, from when the keeper still used it). Sixteen orders a
# minute is the whole budget, so the shared zone is set below that and the burst with it:
# 15r/m is 90 reads a minute, and a burst of 10 is 60 reads at once. Both fit.
#
# They are NOT what keeps the keeper seeing. The keeper reads a different node on purpose
# (ops/host/bootstrap.sh): while the two shared one, an outsider's refusable orders -- five
# reads each, spent BEFORE the refusal -- came out of the same budget the keeper needed to
# notice a breach. Separation fixed that; these numbers only stop the gateway starving itself.
#
# The earlier version of this comment budgeted against 1000 calls in five minutes. That is the
# OTHER node's limit, and it stayed here by mistake when the gateway moved: it would have let
# 30 orders a minute, 180 reads, against a node that allows about 100, and legitimate traders
# would have met upstream_busy from a limit we set ourselves.
limit_req_zone $binary_remote_addr zone=pools_ip:1m rate=12r/m;
limit_req_zone $server_name zone=pools_all:1m rate=15r/m;
# The faucet (gateway/faucet.py) costs about a dozen of that node's calls a grant -- the token's two
# numbers, the wallet's HYPE, two estimates, two sends and their receipts -- out of the orders' budget.
# Two grants a minute from everyone is 26 calls; one a minute from a network. The limits that count
# are the gateway's: one grant an address and three a network a UTC day.
limit_req_zone $binary_remote_addr zone=pools_faucet_ip:1m rate=1r/m;
limit_req_zone $server_name zone=pools_faucet_all:1m rate=2r/m;
# Owners' contacts (gateway/contacts.py). A read costs the node nothing -- the gateway answers it from its
# own file -- so a visitor's pages may ask about once a second. A write costs two of the node's calls the
# first time a pool writes, out of the orders' budget, so writes go by a key of their own, which is empty,
# and so not limited, for a GET.
map $request_method $pools_contacts_writer {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $binary_remote_addr zone=pools_contacts_ip:1m rate=60r/m;
limit_req_zone $pools_contacts_writer zone=pools_contacts_write:1m rate=2r/m;
limit_req_status 429;

# While a gateway is not listening -- a restart, from its stop until it listens again (17 s on
# 26 Oct 2026, when a trader's order met nginx's 502 meanwhile) -- nginx answers for it from the
# server below: nothing was sent, try again in 30 seconds. Only a request nginx could not hand to
# the gateway at all gets there. nginx never passes a POST on to the next server once one has
# received it (proxy_next_upstream, without non_idempotent), so an order the gateway took and then
# lost still answers 502: maybe sent. max_fails=0 keeps the gateway first for every request, so
# the answer stops the moment it listens. 429 and not 503 for the reason gateway/server.py gives
# at `not_sent`: the CDN in front replaces the body of a 5xx with its own page.
upstream pools_gateway {
    server 127.0.0.1:8787 max_fails=0;
    server 127.0.0.1:8786 backup;
}
@INSTANCE_UPSTREAMS@

server {
    listen 127.0.0.1:8786;
    location / {
        default_type application/json;
        add_header Retry-After 30 always;
        return 429 '{"status": "busy", "code": "gateway_restarting", "sent": false, "retry_after_s": 30, "detail": "the gateway is restarting and took nothing; send it again in 30 seconds"}\n';
    }
}

# Any other name, or none, gets no TLS handshake at all.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name pools-api.usenami.io;

    ssl_certificate     /etc/colosseum/tls/origin.crt;
    ssl_certificate_key /etc/colosseum/tls/origin.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # The client address is the one Cloudflare saw, taken only from Cloudflare's own ranges.
@CLOUDFLARE_REAL_IP_FROM@
    real_ip_header CF-Connecting-IP;

    client_max_body_size  64k;
    client_header_timeout 10s;
    client_body_timeout   10s;
    send_timeout          15s;
    keepalive_timeout     15s;
    server_tokens         off;

    location = /v1/order {
        limit_req zone=pools_ip burst=10 nodelay;
        limit_req zone=pools_all burst=10 nodelay;
        proxy_pass http://pools_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }

    location = /v1/health {
        limit_req zone=pools_ip burst=10 nodelay;
        proxy_pass http://pools_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # The client as Cloudflare saw it (real_ip above) goes to the gateway, which limits grants by it.
    location = /v1/faucet {
        limit_req zone=pools_faucet_ip burst=1 nodelay;
        limit_req zone=pools_faucet_all burst=2 nodelay;
        proxy_pass http://pools_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }

    # A pool page's read of its owner's contacts, and the owner's signed write (gateway/contacts.py).
    location = /v1/contacts {
        limit_req zone=pools_contacts_ip burst=20 nodelay;
        limit_req zone=pools_contacts_write burst=2 nodelay;
        proxy_pass http://pools_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

@INSTANCE_LOCATIONS@

    location / {
        return 404;
    }
}
